[
  {
    "name": "task_create",
    "description": "Create a durable project task in the filesystem event log. Use for work that should survive sessions and context compaction.",
    "input_schema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "task",
            "bug",
            "feature",
            "chore",
            "epic"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "assignee": {
          "type": "string"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title"
      ]
    },
    "read_only": false,
    "requires_approval": false
  },
  {
    "name": "task_ready",
